# Real contact/meeting-note data stays local-only. data/contacts.sample.json
# (empty by default) is still tracked and ships in the repo.
data/contacts.json

# Real fetched news leads stay local-only too — no sample/demo data ships
# in the repo. Starts empty and is populated entirely by real refreshes.
data/leads.json
data/market-insights.json

# User-added Market Insights industries (personal configuration, not a
# shipped default) — local-only.
data/custom-industries.json

# Real calendar/schedule stays local-only. data/events.sample.json (demo
# OSU football prospecting events) is tracked and seeds this on first run.
data/events.json

# Audit log of real edits/notes — local-only, no sample seed (starts empty).
data/auditLog.json

# Real tasks stay local-only too. data/tasks.sample.json ships a couple of
# demo tasks and seeds this on first run.
data/tasks.json
