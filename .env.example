# Copy this file to .env.local and fill in your real key.
# .env.local is git-ignored — never committed.

# Required for AI Meeting Prep (Engagement page). Get a key at
# https://www.perplexity.ai/settings/api — this feature costs money per
# use once set, billed by Perplexity, not free like the rest of the app.
PERPLEXITY_API_KEY=

# Optional: override the model used for meeting prep. Defaults to "sonar"
# (cheaper) if unset. "sonar-pro" does deeper research at higher cost.
PERPLEXITY_MODEL=
